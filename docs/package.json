{
  "name": "@laikacms/docs",
  "version": "1.0.1",
  "private": true,
  "description": "Laika documentation site (VitePress).",
  "type": "module",
  "scripts": {
    "generate-adapter-docs": "node scripts/generate-adapter-docs.mjs",
    "generate-api-docs": "node scripts/generate-api-docs.mjs",
    "generate-openapi-docs": "node scripts/generate-openapi-docs.mjs",
    "prebuild-docs": "npm run generate-adapter-docs && npm run generate-api-docs && npm run generate-openapi-docs",
    "dev": "npm run prebuild-docs && vitepress dev",
    "build": "npm run prebuild-docs && vitepress build",
    "preview": "vitepress preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "@scalar/api-reference": "catalog:docs",
    "js-yaml": "catalog:",
    "laikacms": "workspace:*",
    "mermaid": "catalog:docs",
    "typedoc": "catalog:docs",
    "typedoc-plugin-markdown": "catalog:docs",
    "typedoc-vitepress-theme": "catalog:docs",
    "vitepress": "catalog:vue",
    "vitest": "catalog:tools",
    "vue": "catalog:vue"
  },
  "engines": {
    "node": ">=24"
  }
}
