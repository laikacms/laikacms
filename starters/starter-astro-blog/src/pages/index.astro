---
/**
 * Blog homepage.
 *
 * `getCollection` reads the store the Laika loader filled at build time, so the
 * built site has no CMS server dependency.
 */
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="My Blog">
  <h1>My Blog</h1>

  {
    posts.length === 0
      ? (
        <p>
          No posts yet. <a href="/admin/">Open the CMS</a> to write your first post.
        </p>
      )
      : (
        <ul style="list-style:none;padding:0">
          {posts.map(post => (
            <li style="margin-bottom:1.5rem">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
              {' · '}
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString()}
              </time>
              {post.data.description && <p style="margin:0.25rem 0 0">{post.data.description}</p>}
            </li>
          ))}
        </ul>
      )
  }
</Base>
