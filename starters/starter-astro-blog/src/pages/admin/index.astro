---
/**
 * Decap CMS admin UI.
 *
 * The Laika Decap fork is bundled by Vite. Its bare, non-laika app entry
 * (`@laikacms/decap-cms/app/bare`) ships with nothing registered; `src/cms.ts` —
 * generated by the `laika create` wizard — registers exactly the backends,
 * widgets, and locales this site uses.
 *
 * The page is prerendered (static HTML) because the admin is purely
 * client-side once the scripts are loaded.
 */
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Content Manager</title>
  </head>
  <body>
    <script>
      import { init } from '../../cms.js';
      import { blogCollections } from '../../decap-config.js';

      init({
        config: {
          // The complete config is inline; do not also fetch /admin/config.yml.
          load_config_file: false,
          backend: { name: 'laika', base_url: '/__laika', dev_token: 'laika-local-dev' },
          media_folder: 'public/uploads',
          public_folder: '/uploads',
          collections: blogCollections,
        } as any,
      });
    </script>
  </body>
</html>
