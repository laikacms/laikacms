{
  "name": "@laikacms/starter-workers-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog built with Cloudflare Workers + D1 + LaikaCMS. Shows lower-level laikaApi wiring for edge runtimes where createEmbeddedLaika (Node.js / FileSystem) is not available.",
  "type": "module",
  "scripts": {
    "build:admin": "esbuild src/admin-client.ts --bundle --outfile=public/admin/bundle.js --format=esm --platform=browser",
    "dev": "pnpm build:admin && wrangler dev",
    "build": "pnpm build:admin",
    "deploy": "pnpm build:admin && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply starter-workers-blog-db"
  },
  "dependencies": {
    "@laikacms/server": "^4.0.0",
    "@laikacms/decap-cms": "^4.1.0",
    "laikacms": "^3.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260512.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.78.0"
  },
  "engines": {
    "node": ">=22"
  }
}
