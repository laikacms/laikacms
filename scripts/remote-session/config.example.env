# Remote test-session config.
# Copy this to `config.env` (gitignored) and fill in your values.
#
#   cp scripts/remote-session/config.example.env scripts/remote-session/config.env
#
# `config.env` is read by setup-tunnel.sh, setup-access.sh and start.sh.

# A name for the Cloudflare named tunnel. Anything unique to your account.
TUNNEL_NAME=laika-remote-test

# Public hostnames on a domain you control in Cloudflare. These get DNS
# records pointed at the tunnel and an Access (login) policy in front.
# The CMS app (port 3200) is what the customer actually opens in a browser.
APP_HOSTNAME=cms.example.com
APP_PORT=3200

# The gateway (port 8787) holds the GitHub App credentials. Exposed so the
# full GitHub login/publish flow works end to end.
GATEWAY_HOSTNAME=gateway.example.com
GATEWAY_PORT=8787

# Comma-separated emails allowed through the Cloudflare Access login (email
# OTP). Only these people can reach the app; everyone else hits the login wall.
ALLOWED_EMAILS=tester@example.com

# Optional — only needed for the automated Access setup (setup-access.sh).
# Create a token at https://dash.cloudflare.com/profile/api-tokens with the
# "Access: Apps and Policies" Edit permission. Leave blank to configure the
# login gate by hand in the Zero Trust dashboard instead.
CF_API_TOKEN=
CF_ACCOUNT_ID=
