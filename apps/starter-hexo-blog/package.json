{
  "name": "@laikacms/starter-hexo-blog",
  "hexo": { "version": "7.3.0" },
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog built with Hexo (Node.js SSG) + LaikaCMS. Hexo reads from source/_posts/; the LaikaCMS admin sidecar writes to the same directory.",
  "type": "module",
  "scripts": {
    "site:dev": "hexo server --port 4000",
    "site:build": "hexo generate",
    "admin:dev": "tsx watch server/admin.ts",
    "dev": "concurrently -n site,admin -c green,blue \"pnpm site:dev\" \"pnpm admin:dev\"",
    "build": "pnpm site:build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "catalog:server",
    "@laikacms/decap-integrations": "workspace:*",
    "concurrently": "^9.0.0",
    "hexo": "^7.3.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.3.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hono": "catalog:server",
    "laikacms": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
