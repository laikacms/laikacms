<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title ? page.title + ' · ' : '' %><%= config.title %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; max-width: 720px; margin: 0 auto; padding: 1rem 1.5rem; line-height: 1.6; color: #222; }
    a { color: #0066cc; }
    header { border-bottom: 1px solid #eee; margin-bottom: 2rem; padding-bottom: 1rem; display: flex; justify-content: space-between; align-items: center; }
    header h1 { margin: 0; font-size: 1.4rem; }
    nav a { margin-left: 1rem; text-decoration: none; }
    article { margin-bottom: 3rem; }
    article h2 { margin-bottom: 0.25rem; }
    .meta { color: #666; font-size: 0.875rem; margin-bottom: 1rem; }
    footer { border-top: 1px solid #eee; margin-top: 3rem; padding-top: 1rem; color: #666; font-size: 0.875rem; }
  </style>
</head>
<body>
  <header>
    <h1><a href="/" style="text-decoration:none;color:inherit"><%= config.title %></a></h1>
    <nav>
      <% for (const [label, url] of Object.entries(theme.menu)) { %>
        <a href="<%= url %>"><%= label %></a>
      <% } %>
    </nav>
  </header>
  <main><%- body %></main>
  <footer>
    Powered by <a href="https://hexo.io" target="_blank">Hexo</a> + <a href="https://github.com/laikacms/laikacms" target="_blank">LaikaCMS</a>
  </footer>
</body>
</html>
