<article>
  <h1><%= page.title %></h1>
  <p class="meta">
    <%= date(page.date, config.date_format) %>
    <% if (page.tags && page.tags.length) { %>
      &nbsp;·&nbsp;
      <% page.tags.each(tag => { %><a href="<%= tag.path %>">#<%= tag.name %></a> <% }) %>
    <% } %>
    <% if (page.categories && page.categories.length) { %>
      &nbsp;·&nbsp;
      <% page.categories.each(cat => { %><a href="<%= cat.path %>"><%= cat.name %></a> <% }) %>
    <% } %>
  </p>
  <%- page.content %>
</article>

<nav style="display:flex;justify-content:space-between;margin-top:3rem">
  <div><% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } %></div>
  <div><% if (page.next) { %><a href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %></div>
</nav>
