{
  "name": "@laikacms/starter-hapi-vision-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog using Hapi + @hapi/vision + Nunjucks + remark Markdown + LaikaCMS. Hapi's plugin-based architecture: @hapi/inert for static files, @hapi/vision for templates \u2014 registered via server.register() before routes.",
  "type": "module",
  "scripts": {
    "build:admin": "esbuild src/admin-client.ts --bundle --outfile=public/admin/bundle.js --format=esm --platform=browser",
    "dev": "pnpm build:admin && tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hapi/hapi": "catalog:server",
    "@hapi/inert": "catalog:server",
    "@hapi/vision": "^7.0.0",
    "@laikacms/decap-integrations": "workspace:*",
    "decap-cms-app": "catalog:decap",
    "laikacms": "workspace:*",
    "nunjucks": "catalog:templating",
    "rehype-stringify": "catalog:markdown",
    "remark": "catalog:markdown",
    "remark-rehype": "catalog:markdown",
    "unified": "catalog:markdown"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@types/nunjucks": "catalog:types",
    "esbuild": "catalog:tools",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": "22.x"
  }
}
