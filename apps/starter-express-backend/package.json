{
  "name": "@laikacms/starter-express-backend",
  "description": "Starter: classic Express backend with an explicit req/res \u2194 Web Request/Response adapter so it can host the LaikaCMS web-standard fetch handler.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:admin": "esbuild src/admin-client.ts --bundle --outfile=public/admin/bundle.js --format=esm --platform=browser",
    "dev": "pnpm build:admin && tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "pnpm build:admin && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@laikacms/decap-integrations": "workspace:*",
    "decap-cms-app": "catalog:decap",
    "express": "^4.21.0",
    "laikacms": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "catalog:types",
    "esbuild": "catalog:tools",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  }
}
