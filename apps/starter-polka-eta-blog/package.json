{
  "name": "@laikacms/starter-polka-eta-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog using Polka + Eta templates + remark Markdown rendering + LaikaCMS. Polka is a tiny Express alternative (~4KB) used by SvelteKit's dev server. Eta is a TypeScript-native, ESM-first template engine.",
  "type": "module",
  "scripts": {
    "build:admin": "esbuild src/admin-client.ts --bundle --outfile=public/admin/bundle.js --format=esm --platform=browser",
    "dev": "pnpm build:admin && tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@laikacms/decap-integrations": "workspace:*",
    "decap-cms-app": "catalog:decap",
    "eta": "^3.5.0",
    "laikacms": "workspace:*",
    "polka": "catalog:server",
    "rehype-stringify": "catalog:markdown",
    "remark": "catalog:markdown",
    "remark-rehype": "catalog:markdown",
    "sirv": "catalog:server",
    "unified": "catalog:markdown"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "esbuild": "catalog:tools",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": "22.x"
  }
}
