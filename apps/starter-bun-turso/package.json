{
  "name": "@laikacms/starter-bun-turso",
  "version": "0.0.1",
  "private": true,
  "description": "Blog on Bun's native HTTP server backed by Turso (libSQL). Zero-adapter laika.fetch + WHATWG-native Bun.serve().",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@laikacms/decap-integrations": "workspace:*",
    "@laikacms/libsql": "workspace:*",
    "laikacms": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "catalog:tools"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
