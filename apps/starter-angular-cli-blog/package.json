{
  "name": "@laikacms/starter-angular-cli-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog built with Angular 21 SSR (@angular/ssr) + LaikaCMS. Shows the standard Angular CLI workflow: ng serve for dev, ng build for production, plus an Express server that bridges Web API Request/Response for the Decap proxy and serves Angular-rendered pages.",
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "start": "node dist/starter-angular-ssr-blog/server/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.0",
    "@laikacms/decap-integrations": "workspace:*",
    "express": "^5.1.0",
    "laikacms": "workspace:*",
    "rxjs": "^7.8.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "catalog:types",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": "22.x"
  }
}
