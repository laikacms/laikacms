    "@remix-run/react": "^2.0.0",
    "@remix-run/serve": "^2.0.0",
    "isbot": "catalog:",
    "laikacms": "workspace:*",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.0.0",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "typescript": "catalog:tools",
