{
  "name": "@laikacms/starter-dynamodb-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog backed by AWS DynamoDB. Content stored in a single-table design; full CRUD via the official AWS SDK v3; Decap admin from CDN.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "catalog:aws",
    "@aws-sdk/lib-dynamodb": "catalog:aws",
    "@hono/node-server": "catalog:server",
    "@laikacms/aws": "workspace:*",
    "@laikacms/decap-integrations": "workspace:*",
    "hono": "catalog:server",
    "laikacms": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": "22.x"
  }
}
