{
  "name": "@laikacms/starter-jose-auth",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog with production JWT auth using jose + LaikaCMS. Demonstrates auth: { mode: 'custom' } with signed JWTs and the decapAdminHtml devToken option for server-side token injection.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "catalog:server",
    "@laikacms/decap-integrations": "workspace:*",
    "hono": "catalog:server",
    "jose": "^6.0.0",
    "laikacms": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": "22.x"
  }
}
