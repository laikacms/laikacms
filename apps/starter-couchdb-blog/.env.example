# CouchDB HTTP endpoint including the database name.
# Format: http(s)://host:port/database-name
COUCHDB_URL=http://localhost:5984/laikacms

# Basic auth (typical self-hosted setup).
COUCHDB_USERNAME=admin
COUCHDB_PASSWORD=

# Bearer JWT (IBM Cloudant IAM; takes precedence over Basic).
COUCHDB_BEARER=

# HTTP port for this blog server. Default: 3000
PORT=3000
