{
  "name": "@laikacms/starter-bun-backend",
  "description": "Starter: headless backend on the Bun runtime exposing LaikaCMS over JSON:API + a Decap admin shell.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:admin": "esbuild src/admin-client.ts --bundle --outfile=public/admin/bundle.js --format=esm --platform=browser",
    "dev": "pnpm build:admin && bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "pnpm build:admin",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@laikacms/decap-integrations": "workspace:*",
    "decap-cms-app": "catalog:decap",
    "laikacms": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "esbuild": "catalog:tools",
    "typescript": "catalog:tools"
  }
}
