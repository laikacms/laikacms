---
layout: base.njk
---
<article>
  <h1>{{ title }}</h1>
  {% if date %}
    <time style="color:#666">{{ date | date("MMMM d, yyyy") }}</time>
  {% endif %}
  {% if description %}
    <p><em>{{ description }}</em></p>
  {% endif %}
  {{- content | safe }}
  <p><a href="/">← Back</a></p>
</article>
