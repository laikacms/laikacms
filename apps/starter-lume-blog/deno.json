{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "tasks": {
    "site:dev": "deno run -A --watch=content/ _config.ts --serve --port=3000",
    "site:build": "deno run -A _config.ts",
    "admin:dev": "deno run -A --watch=server/,lib/ server/admin.ts",
    "dev": "deno run -A npm:concurrently -n site,admin -c green,blue \"deno task site:dev\" \"deno task admin:dev\"",
    "build": "deno task site:build",
    "check": "deno check _config.ts server/admin.ts lib/laika.ts lib/decap-config.ts"
  },
  "imports": {
    "lume/": "https://deno.land/x/lume@v2.4.3/",
    "lume/mod.ts": "https://deno.land/x/lume@v2.4.3/mod.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noImplicitAny": true
  }
}
