{
  "name": "@laikacms/starter-loopback-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog built with LoopBack 4 + LaikaCMS. Shows how to bridge LoopBack's request lifecycle to laika.fetch via an outer Express wrapper so LoopBack's body parser never touches the Decap API routes.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@laikacms/decap-integrations": "workspace:*",
    "@loopback/core": "^6.1.10",
    "@loopback/rest": "^14.0.13",
    "express": "^4.21.0",
    "laikacms": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.22",
    "@types/node": "catalog:types",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  }
}
