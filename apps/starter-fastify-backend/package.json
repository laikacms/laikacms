{
  "name": "@laikacms/starter-fastify-backend",
  "description": "Starter: Fastify 5 backend exposing LaikaCMS over JSON:API + a Decap admin shell. Uses the same web-standard adapter pattern as the Express starter.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:admin": "esbuild src/admin-client.ts --bundle --outfile=public/admin/bundle.js --format=esm --platform=browser",
    "dev": "pnpm build:admin && tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "pnpm build:admin && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@laikacms/decap-integrations": "workspace:*",
    "decap-cms-app": "catalog:decap",
    "fastify": "^5.1.0",
    "laikacms": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "esbuild": "catalog:tools",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  }
}
