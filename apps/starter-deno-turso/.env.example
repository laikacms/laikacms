# Turso database URL
# Cloud: https://<db-name>-<org>.turso.io
# Local sqld: http://localhost:8080
LIBSQL_URL=http://localhost:8080

# Turso auth token (omit for local sqld)
# LIBSQL_AUTH_TOKEN=your-token-here

# Optional: custom table name (default: laika_storage)
# LIBSQL_TABLE=laika_storage

# Optional: HTTP port (default: 3000)
# PORT=3000

# Deno reads env vars via Deno.env.get() — requires --allow-env permission.
# Pass with: LIBSQL_URL=... deno task dev
# Or add to a .env file and use --env-file flag (Deno 1.38+):
# deno run --allow-net --allow-env --env-file=.env src/main.ts
