{
  "name": "@laikacms/starter-foalts-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog built with FoalTS v4 + LaikaCMS. Decorator-based TypeScript MVC; Decap API proxy uses express.raw() in an outer Express wrapper to capture the body before FoalTS's own body parser runs.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foal/core": "^4.0.0",
    "@laikacms/decap-integrations": "workspace:*",
    "express": "^4.21.0",
    "laikacms": "workspace:*",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "catalog:types",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": "22.x"
  }
}
