<h1>My Blog</h1>

{{#if posts.length}}
  <ul style="list-style:none;padding:0">
    {{#each posts}}
      <li style="margin-bottom:1rem">
        <a href="/blog/{{this.slug}}">{{this.slug}}</a>
        {{#if this.date}} · <time>{{this.date}}</time>{{/if}}
      </li>
    {{/each}}
  </ul>
{{else}}
  <p>No posts yet. <a href="/admin/">Open the CMS</a> to write your first post.</p>
{{/if}}
