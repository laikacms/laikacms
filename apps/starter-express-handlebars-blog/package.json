{
  "name": "@laikacms/starter-express-handlebars-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog using Express + Handlebars templates + remark Markdown rendering + LaikaCMS. Mustache-syntax logic-less templates with layouts and partials.",
  "type": "module",
  "scripts": {
    "build:admin": "esbuild src/admin-client.ts --bundle --outfile=public/admin/bundle.js --format=esm --platform=browser",
    "dev": "pnpm build:admin && tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@laikacms/decap-integrations": "workspace:*",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.0",
    "laikacms": "workspace:*",
    "rehype-stringify": "^10.0.0",
    "remark": "^15.0.0",
    "remark-rehype": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "catalog:types",
    "esbuild": "catalog:tools",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": "22.x"
  }
}
