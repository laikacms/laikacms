{
  "name": "@laikacms/starter-d1-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog using Cloudflare D1 (serverless SQLite) as the content store via D1StorageRepository + createCustomLaika. Accessible from Node.js over the Cloudflare REST API.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "catalog:server",
    "@laikacms/cloudflare": "workspace:*",
    "@laikacms/decap-integrations": "workspace:*",
    "hono": "catalog:server",
    "laikacms": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": "22.x"
  }
}
