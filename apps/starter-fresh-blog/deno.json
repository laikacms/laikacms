{
  "imports": {
    "fresh": "jsr:@fresh/core@^2.0.0",
    "preact": "npm:preact@^10.0.0",
    "preact/hooks": "npm:preact@^10.0.0/hooks",
    "preact/jsx-runtime": "npm:preact@^10.0.0/jsx-runtime"
  },
  "tasks": {
    "dev": "deno serve --port ${PORT:-3000} --allow-net --allow-read --allow-write --allow-env --watch main.ts",
    "start": "deno serve --port ${PORT:-3000} --allow-net --allow-read --allow-write --allow-env main.ts",
    "check": "deno check main.ts routes/**/*.ts routes/**/*.tsx lib/**/*.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noImplicitAny": true
  },
  "nodeModulesDir": "auto"
}
