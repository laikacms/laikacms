extends layout

block content
  h1 My Blog

  if posts.length === 0
    p No posts yet.
      |
      a(href="/admin/") Open the CMS
      |  to write your first post.
  else
    ul(style="list-style:none;padding:0")
      each post in posts
        li(style="margin-bottom:1rem")
          a(href=`/blog/${post.slug}`)= post.slug
          if post.date
            |  ·
            time= post.date
