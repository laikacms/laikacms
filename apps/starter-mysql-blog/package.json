{
  "name": "@laikacms/starter-mysql-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog using Hono + LaikaCMS + MySQL2 + Drizzle. DrizzleStorageRepository with MySQL dialect — varchar PKs, no RETURNING clause, inArray for post-insert selects.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "catalog:server",
    "@laikacms/decap-integrations": "workspace:*",
    "drizzle-orm": "catalog:drizzle",
    "hono": "catalog:server",
    "laikacms": "workspace:*",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": "22.x"
  }
}
