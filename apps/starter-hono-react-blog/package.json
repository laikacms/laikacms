{
  "name": "@laikacms/starter-hono-react-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog using Hono + React 19 streaming SSR (renderToReadableStream) + LaikaCMS. Hono is WHATWG-native so laika.fetch(c.req.raw) needs no adapter.",
  "type": "module",
  "scripts": {
    "build:admin": "esbuild src/admin-client.tsx --bundle --outfile=public/admin/bundle.js --format=esm --platform=browser --jsx=automatic",
    "dev": "pnpm build:admin && tsx watch src/server.tsx",
    "build": "pnpm build:admin",
    "start": "tsx src/server.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "catalog:server",
    "@laikacms/decap-integrations": "workspace:*",
    "hono": "catalog:server",
    "laikacms": "workspace:*",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "esbuild": "catalog:tools",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": "22.x"
  }
}
