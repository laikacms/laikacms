{
  "name": "@laikacms/starter-hono-bun-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog using Hono natively on Bun. No @hono/node-server — Bun picks up 'export default { fetch }' directly. serveStatic from hono/bun. Zero-adapter laika.fetch.",
  "type": "module",
  "scripts": {
    "build:admin": "esbuild src/admin-client.ts --bundle --outfile=public/admin/bundle.js --format=esm --platform=browser",
    "dev": "pnpm build:admin && bun --watch src/server.ts",
    "build": "pnpm build:admin",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@laikacms/decap-integrations": "workspace:*",
    "hono": "catalog:server",
    "laikacms": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "esbuild": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
