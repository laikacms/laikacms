{
  "name": "@laikacms/starter-koa-liquid-blog",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog using Koa + LiquidJS templates + remark Markdown rendering + LaikaCMS. Liquid is Shopify's template language — used by Jekyll, GitHub Pages, and Eleventy. Sandboxed: no arbitrary code execution in templates.",
  "type": "module",
  "scripts": {
    "build:admin": "esbuild src/admin-client.ts --bundle --outfile=public/admin/bundle.js --format=esm --platform=browser",
    "dev": "pnpm build:admin && tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@koa/router": "catalog:server",
    "@laikacms/decap-integrations": "workspace:*",
    "decap-cms-app": "catalog:decap",
    "koa": "catalog:server",
    "koa-static": "catalog:server",
    "laikacms": "workspace:*",
    "liquidjs": "^10.0.0",
    "rehype-stringify": "catalog:markdown",
    "remark": "catalog:markdown",
    "remark-rehype": "catalog:markdown",
    "unified": "catalog:markdown"
  },
  "devDependencies": {
    "@types/koa": "catalog:types",
    "@types/koa__router": "catalog:types",
    "@types/koa-static": "catalog:types",
    "@types/node": "catalog:types",
    "esbuild": "catalog:tools",
    "tsx": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": "22.x"
  }
}
