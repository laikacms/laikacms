{
  "name": "@laikacms/starter-workers-turso",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare Workers blog backed by Turso (libSQL). Zero Node.js — runs in V8 isolates via fetch-only hrana HTTP transport. Shows createCustomLaika + LibSqlStorageRepository on the edge.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 3000",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@laikacms/decap-integrations": "workspace:*",
    "@laikacms/libsql": "workspace:*",
    "hono": "catalog:server",
    "laikacms": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:types",
    "typescript": "catalog:tools",
    "wrangler": "catalog:tools"
  }
}
