{
  "name": "@laikacms/starter-bun-sqlite",
  "version": "0.0.1",
  "private": true,
  "description": "Starter blog: Hono on Bun + DrizzleStorageRepository over Bun's native SQLite. Zero external DB dependencies — bun:sqlite is built into the Bun runtime.",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@laikacms/decap-integrations": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "hono": "catalog:server",
    "laikacms": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "catalog:tools"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
