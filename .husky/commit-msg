# Block new .github/workflows/ files unless the commit message contains
# [owner-approved-workflow] (GitHub Actions billing frozen 2026-06-17).
# Lives in commit-msg (not pre-commit) because only this hook can read the
# pending message ($1); `|| true` keeps husky's `sh -e` from aborting on no match.
new_workflows=$(git diff --cached --name-only --diff-filter=A | grep '^\.github/workflows/' || true)
if [ -n "$new_workflows" ] && ! grep -qF '[owner-approved-workflow]' "$1"; then
  echo "ERROR: new GitHub Actions workflow files are blocked (Actions billing frozen)."
  echo "Move the check into a husky hook or package.json script instead."
  echo "To override with owner approval, include [owner-approved-workflow] in your commit message."
  echo "Blocked files:"
  echo "$new_workflows"
  exit 1
fi
