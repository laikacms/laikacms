{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../types",
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "paths": {
      // decap-cms-core@3.13.0 ships index.d.ts for the root specifier — no path override needed.
      // The wildcard must stay: v3 ships no exports map and has no types/ or actions/ at package
      // root, so deep subpaths like 'decap-cms-core/types/redux' and
      // 'decap-cms-core/actions/entries' only resolve through our hand-written shims.
      "decap-cms-core/*": [
        "../../types/decap-cms-core/*"
      ],
      "decap-cms-lib-util": [
        "../../types/decap-cms-lib-util/index.d.ts"
      ],
      "decap-cms-lib-util/*": [
        "../../types/decap-cms-lib-util/*"
      ],
      "decap-cms-ui-default": [
        "../../types/decap-cms-ui-default/index.d.ts"
      ],
      "decap-cms-ui-default/*": [
        "../../types/decap-cms-ui-default/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}
