{
  "name": "decap-cms-widget-portabletext-editor",
  "description": "Decap CMS widget backed by @portabletext/editor (Sanity's native Portable Text editor). Sibling of decap-cms-widget-lexicaleditor.",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": "22.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@laikacloud/portabletext-core": "workspace:*",
    "@portabletext/editor": "catalog:portabletext",
    "@portabletext/keyboard-shortcuts": "catalog:portabletext",
    "@portabletext/react": "catalog:portabletext",
    "@portabletext/types": "catalog:portabletext",
    "@emotion/css": "catalog:emotion",
    "@emotion/react": "catalog:emotion",
    "@emotion/styled": "catalog:emotion",
    "lucide-react": "catalog:icons"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "happy-dom": "^20.0.0",
    "rimraf": "catalog:tools",
    "typescript": "catalog:tools",
    "vitest": "catalog:testing"
  }
}
