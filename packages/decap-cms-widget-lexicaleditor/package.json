{
  "name": "decap-cms-widget-lexicaleditor",
  "description": "Lexical-based rich text widget for Decap CMS, built on a shadcn-editor fork.",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": "22.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@laikacms/lexical-editor": "workspace:*",
    "lexical": "catalog:lexical",
    "@portabletext/react": "catalog:portabletext"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "happy-dom": "catalog:testing",
    "rimraf": "catalog:tools",
    "typescript": "catalog:tools",
    "vitest": "catalog:testing"
  }
}
