{
  "name": "laikacli",
  "version": "0.1.0",
  "description": "The Laika CMS command-line interface (`laikacli`, short alias `laika`): local dev storage server, config-to-typed-TypeScript codegen, and storage repository migrations.",
  "keywords": [
    "headless-cms",
    "content-management",
    "laikacms",
    "cli",
    "development"
  ],
  "author": "Sem Postma <sem@laikacms.com>",
  "license": "MIT",
  "homepage": "https://github.com/laikacms/laikacms",
  "repository": "https://github.com/laikacms/laikacms",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "laikacli": "./dist/cli.js",
    "laika": "./dist/cli.js"
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "build": "tsup && chmod +x dist/cli.js",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:default",
    "@laikacms/local": "workspace:*",
    "effect": "catalog:default"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "rimraf": "catalog:tools",
    "tsup": "catalog:tools",
    "typescript": "catalog:tools"
  },
  "engines": {
    "node": ">=22"
  }
}
